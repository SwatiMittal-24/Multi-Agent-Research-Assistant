# Multi-Agent Research Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your actual API credentials.
# DO NOT commit the actual '.env' file to version control.

# Google Gemini API Key (starts with AIzaSy...)
# Obtain free from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Serper API Key for Google Search integration
# Obtain free tier from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
